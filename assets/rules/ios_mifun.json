{
 "format": "anx-rule/2",
 "id": "ios_mifun",
 "name": "MiFun",
 "baseUrl": "https://ios.mifun.org",
 "iconUrl": "https://ugc.hitv.com/1/230324151010E2CA349174CE432E9353E29DE5C0EQ0NF/sVoWeL0.png?mxtheme/images/favicon.png",
 "description": "MiFun在线动漫专注于资源收集整理，海量有效的高质量动漫资源在线观看，完全免费。",
 "useWebview": true,
 "headers": {
  "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "Accept": "*/*",
  "Referer": "https://ios.mifun.org/"
 },
 "search": [
  {
   "op": "fetch",
   "url": "/index.php/ajax/suggest?mid=1&wd={keyword}&limit=20",
   "headers": {
    "X-Requested-With": "XMLHttpRequest"
   }
  },
  {
   "op": "jsonSeries",
   "listPath": "list",
   "idKey": "id",
   "nameKey": "name",
   "imageKey": "pic",
   "detailUrlTemplate": "/voddetail/{id}/"
  }
 ],
 "detail": [
  {
   "op": "follow"
  },
  {
   "op": "episodes",
   "listSelectors": [
    "ul.hl-plays-list"
   ],
   "tabSelectors": [
    ".hl-plays-from a"
   ],
   "tabAttr": "alt"
  }
 ],
 "play": [
  {
   "op": "follow"
  },
  {
   "op": "playerAaaa",
   "var": "player_aaaa",
   "key": "url"
  },
  {
   "op": "setVar",
   "name": "mediaToken",
   "value": "{url:raw}"
  },
  {
   "op": "first",
   "branches": [
    [
     {
      "op": "fetch",
      "url": "https://data.m3u8.in/player/?url={mediaToken}"
     },
     {
      "op": "regex",
      "pattern": "const\\s+Sign\\s*=\\s*\"([^\"]+)\"",
      "group": 1
     },
     {
      "op": "setVar",
      "name": "mediaSign",
      "value": "{url:raw}"
     },
     {
      "op": "fetch",
      "url": "https://data.m3u8.in/player/api.php?url={mediaToken}&sign={mediaSign}",
      "headers": {
       "X-Requested-With": "XMLHttpRequest",
       "Referer": "https://data.m3u8.in/player/?url={mediaToken}"
      }
     },
     {
      "op": "json",
      "path": "url"
     },
     {
      "op": "regex",
      "pattern": "^(https?://[^/\\s]+/[^?#\\s]*\\.(?:m3u8|mp4|mkv|flv)(?:[?#]\\S*)?|https://(?:[a-z0-9-]+\\.)?douyinvod\\.com/[^?#\\s]*/video/tos/\\S+|https://[a-z0-9-]+\\.byteimg\\.com/[^?#\\s]+\\.mp4~[^?#\\s]+\\.image\\?[^#\\s]+)$",
      "group": 1,
      "ignoreCase": true
     }
    ],
    [
     {
      "op": "template",
      "value": "https://data.m3u8.in/player/?url={mediaToken}"
     },
     {
      "op": "sniff",
      "goal": "video"
     }
    ],
    [
     {
      "op": "sniff",
      "goal": "video",
      "url": "{episodeId:raw}"
     }
    ]
   ]
  },
  {
   "op": "setMediaHeaders",
   "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
   },
   "remove": [
    "Referer"
   ]
  }
 ],
 "home": [
  {
   "op": "fetch",
   "url": "/index.php/ajax/data?mid=1&limit=30&page=1",
   "headers": {
    "X-Requested-With": "XMLHttpRequest"
   }
  },
  {
   "op": "jsonSeries",
   "listPath": "list",
   "idKey": "vod_id",
   "nameKey": "vod_name",
   "imageKey": "vod_pic",
   "descKey": "vod_remarks",
   "detailUrlTemplate": "/voddetail/{id}/"
  }
 ],
 "categories": [
  {
   "id": "1",
   "name": "番剧"
  },
  {
   "id": "2",
   "name": "国创"
  },
  {
   "id": "3",
   "name": "剧场"
  },
  {
   "id": "4",
   "name": "美漫"
  },
  {
   "id": "5",
   "name": "特摄"
  }
 ],
 "category": [
  {
   "op": "fetch",
   "url": "/vodtype/{categoryId}/"
  },
  {
   "op": "searchList",
   "selectors": [
    "li.hl-list-item"
   ],
   "detailPattern": "/voddetail/",
   "linkSelector": "a.hl-item-thumb",
   "titleAttr": "title",
   "imageSelector": "a.hl-item-thumb",
   "imageAttr": "data-original",
   "descSelector": ".hl-pic-tag span"
  }
 ]
}
