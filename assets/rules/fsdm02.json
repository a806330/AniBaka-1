{
 "format": "anx-rule/2",
 "id": "fsdm02",
 "name": "番薯动漫",
 "baseUrl": "https://www.fsdm02.com",
 "iconUrl": "https://p0.ssl.qhimg.com/t016852bd7df93fb9de.png",
 "description": "番薯动漫视频源",
 "headers": {
  "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
  "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
  "Accept-Language": "zh-CN,zh;q=0.9",
  "Referer": "https://www.fsdm02.com/"
 },
 "search": [
  {
   "op": "first",
   "branches": [
    [
     {
      "op": "fetch",
      "url": "/api.php/provide/vod/?ac=list&wd={keyword}"
     },
     {
      "op": "jsonSeries",
      "listPath": "list",
      "idKey": "vod_id",
      "nameKey": "vod_name",
      "imageKey": "vod_pic",
      "descKey": "vod_remarks"
     }
    ],
    [
     {
      "op": "sniff",
      "goal": "html",
      "url": "/api.php/provide/vod/?ac=list&wd={keyword}",
      "readyContains": [
       "\"list\""
      ],
      "rejectContains": [
       "DokiDoki CDN",
       "dooki.cloud",
       "X-GE-UA-Step",
       "__cf_chl_"
      ],
      "timeoutMs": 60000,
      "settleMs": 0
     },
     {
      "op": "select",
      "css": "body",
      "attr": "text"
     },
     {
      "op": "jsonSeries",
      "listPath": "list",
      "idKey": "vod_id",
      "nameKey": "vod_name",
      "imageKey": "vod_pic",
      "descKey": "vod_remarks"
     }
    ]
   ]
  }
 ],
 "detail": [
  {
   "op": "follow",
   "headers": {
    "Referer": "https://www.fsdm02.com/"
   }
  },
  {
   "op": "episodes",
   "listSelectors": [
    ".module-play-list"
   ],
   "tabSelectors": [
    ".module-tab-item[data-dropdown-value]"
   ],
   "tabAttr": "data-dropdown-value"
  }
 ],
 "play": [
  {
   "op": "follow",
   "headers": {
    "Referer": "https://www.fsdm02.com/"
   }
  },
  {
   "op": "playerAaaa",
   "var": "player_aaaa",
   "key": "url"
  },
  {
   "op": "videoUrl"
  }
 ],
 "useWebview": true,
 "directConnection": true,
 "home": [
  {
   "op": "fetch",
   "url": "/"
  },
  {
   "op": "searchList",
   "selectors": [
    "a.module-poster-item",
    "a.module-item"
   ],
   "detailPattern": "/voddetail/",
   "titleAttr": "title",
   "imageSelector": "img",
   "imageAttr": "data-original",
   "descSelector": ".module-item-note"
  }
 ],
 "categories": [
  {
   "id": "1",
   "name": "TV番剧"
  },
  {
   "id": "22",
   "name": "国产动漫"
  },
  {
   "id": "3",
   "name": "剧场版"
  },
  {
   "id": "21",
   "name": "欧美动漫"
  }
 ],
 "category": [
  {
   "op": "fetch",
   "url": "/vodtype/{categoryId}.html"
  },
  {
   "op": "searchList",
   "selectors": [
    "a.module-poster-item",
    "a.module-item"
   ],
   "detailPattern": "/voddetail/",
   "titleAttr": "title",
   "imageSelector": "img",
   "imageAttr": "data-original",
   "descSelector": ".module-item-note"
  }
 ]
}
